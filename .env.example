# ==============================================================================
# CONFIGURACIÓN DE PROVEEDORES DE INTELIGENCIA ARTIFICIAL (TUTOR VIRTUAL)
# ==============================================================================
# Selecciona tu proveedor preferido: "gemini" o "deepseek"
AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 1. Google Gemini (Recomendado - Nivel gratuito en Google AI Studio)
# Obtén tu API Key gratuita en: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 2. DeepSeek (DeepSeek API)
# Obtén tu API Key en: https://platform.deepseek.com/
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=tu_api_key_de_deepseek_aqui
DEEPSEEK_MODEL=deepseek-chat
